<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Excel and PDF export live in a separate assembly so the core control library
    stays dependency-free. Applications that only need CSV never pull ClosedXML or
    QuestPDF into their output.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>TreeGrid.Wpf.Export</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>TreeGrid.Wpf.Export</PackageId>
    <Title>TreeGrid for WPF - Excel and PDF export</Title>
    <Description>Excel (.xlsx) and PDF exporters for the TreeGrid.Wpf control, built on ClosedXML and QuestPDF. Exports keep the hierarchy as indentation, a level column, or native Excel outline grouping.</Description>
    <PackageTags>wpf;treegrid;tree-grid;export;excel;xlsx;pdf;closedxml;questpdf</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.1" />
    <PackageReference Include="QuestPDF" Version="2024.12.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TreeGrid.Wpf\TreeGrid.Wpf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\nuget\TreeGrid.Wpf.Export.md" Pack="true" PackagePath="README.md" Visible="false" />
  </ItemGroup>

</Project>
