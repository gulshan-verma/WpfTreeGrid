<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Excel and PDF export live in a separate assembly so the core control library
    stays dependency-free. Applications that only need CSV never pull ClosedXML or
    QuestPDF into their output.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>TreeGrid.Wpf.Export</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.1" />
    <PackageReference Include="QuestPDF" Version="2024.12.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TreeGrid.Wpf\TreeGrid.Wpf.csproj" />
  </ItemGroup>

</Project>
