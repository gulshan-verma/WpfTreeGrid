<Window x:Class="TreeGrid.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tg="clr-namespace:TreeGrid.Wpf;assembly=TreeGrid.Wpf"
        xmlns:cols="clr-namespace:TreeGrid.Wpf.Columns;assembly=TreeGrid.Wpf"
        xmlns:headers="clr-namespace:TreeGrid.Wpf.Headers;assembly=TreeGrid.Wpf"
        xmlns:local="clr-namespace:TreeGrid.Demo"
        Title="TreeGrid - Feature Explorer"
        Height="760"
        Width="1420"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource TreeGrid.Background}">

    <Window.Resources>
        <!-- ======================= Custom context menus =======================
             The grid sets the menu's DataContext to a RecordContextMenuInfo or
             HeaderContextMenuInfo for the row/column that was clicked, so items can
             bind straight to it. Note that {Binding} inside these menus therefore
             refers to that info object, not to the window.
        -->
        <ContextMenu x:Key="RowMenu">
            <MenuItem Header="{Binding Record.FirstName, StringFormat='Copy name of {0}'}"
                      Click="OnRowMenuCopyName" />
            <MenuItem Header="{Binding Column.HeaderText, StringFormat='Copy this {0} cell'}"
                      Click="OnRowMenuCopyCell" />
            <Separator />
            <!-- Tag rather than x:Name: elements inside a ResourceDictionary are in a
                 separate namescope, so a generated field is not guaranteed. -->
            <MenuItem Tag="ExpandSubtree" Header="Expand this subtree"
                      Click="OnRowMenuExpandSubtree" />
            <MenuItem Header="Select whole level" Click="OnRowMenuSelectLevel" />
            <Separator />
            <MenuItem Header="Show details..." Click="OnRowMenuDetails" />
        </ContextMenu>

        <ContextMenu x:Key="HeaderMenu">
            <MenuItem Header="{Binding Column.HeaderText, StringFormat='Sort {0} A-Z'}"
                      Click="OnHeaderMenuSortAsc" />
            <MenuItem Header="{Binding Column.HeaderText, StringFormat='Sort {0} Z-A'}"
                      Click="OnHeaderMenuSortDesc" />
            <Separator />
            <MenuItem Header="Group by this column" Click="OnHeaderMenuGroup" />
            <MenuItem Header="Hide this column" Click="OnHeaderMenuHide" />
            <MenuItem Header="Auto-fit all columns" Click="OnHeaderMenuAutoFit" />
        </ContextMenu>

        <local:BrushNameConverter x:Key="BrushNameConverter" />
        <local:BandBrushConverter x:Key="BandBrushConverter" />
        <local:BandTextConverter x:Key="BandTextConverter" />
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource TreeGrid.ExpanderGlyph}" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3,0,3" />
            <Setter Property="Foreground" Value="{DynamicResource TreeGrid.CellForeground}" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,6,0,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TreeGrid.CellForeground}" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TreeGrid.CellForeground}" />
        </Style>
        <Style TargetType="CheckBox" x:Key="ThemedCheck">
            <Setter Property="Foreground" Value="{DynamicResource TreeGrid.CellForeground}" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <DataTemplate x:Key="SwatchTemplate">
            <StackPanel Orientation="Horizontal">
                <Border Width="14" Height="14" Margin="0,0,6,0"
                        BorderBrush="#80000000" BorderThickness="1"
                        Background="{Binding}" />
                <TextBlock Text="{Binding Converter={StaticResource BrushNameConverter}}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================================================ Feature sidebar -->
        <Border Grid.Column="0"
                BorderBrush="{DynamicResource TreeGrid.BorderBrush}"
                BorderThickness="1"
                Background="{DynamicResource TreeGrid.HeaderBackground}"
                Padding="10"
                Margin="0,0,8,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="FEATURES" FontWeight="Bold" FontSize="12" />
                    <TextBlock Text="Every toggle applies live to the grid on the right."
                               TextWrapping="Wrap" FontSize="10"
                               Foreground="{DynamicResource TreeGrid.ExpanderGlyph}" Margin="0,2,0,0" />

                    <TextBlock Text="SELECTION" Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="Mode" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding SelectionModes}"
                              SelectedItem="{Binding ElementName=Tree, Path=SelectionMode, Mode=TwoWay}" />
                    <TextBlock Text="Unit" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding SelectionUnits}"
                              SelectedItem="{Binding ElementName=Tree, Path=SelectionUnit, Mode=TwoWay}" />
                    <CheckBox Content="Observe entity IsSelected/IsChecked"
                              IsChecked="{Binding ElementName=Tree, Path=ObserveMemberPathChanges, Mode=TwoWay}" />
                    <Button Content="Select first 3 via entity" Margin="0,4,0,0" Padding="6,3"
                            Click="OnSelectViaEntity" />
                    <CheckBox Content="Checkbox selection"
                              IsChecked="{Binding ElementName=Tree, Path=AllowCheckBoxSelection, Mode=TwoWay}" />
                    <TextBlock Text="Cascade" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding CascadeModes}"
                              SelectedItem="{Binding ElementName=Tree, Path=CheckBoxCascadeMode, Mode=TwoWay}" />

                    <TextBlock Text="SORT AND FILTER" Style="{StaticResource SectionHeader}" />
                    <CheckBox Content="Allow sorting"
                              IsChecked="{Binding ElementName=Tree, Path=AllowSorting, Mode=TwoWay}" />
                    <CheckBox Content="Allow multi-sort (Ctrl+click)"
                              IsChecked="{Binding ElementName=Tree, Path=AllowMultiSort, Mode=TwoWay}" />
                    <CheckBox Content="Show sort order badges"
                              IsChecked="{Binding ElementName=Tree, Path=ShowSortNumbers, Mode=TwoWay}" />
                    <CheckBox Content="Allow filtering"
                              IsChecked="{Binding ElementName=Tree, Path=AllowFiltering, Mode=TwoWay}" />
                    <TextBlock Text="Filter node mode" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding FilterNodeModes}"
                              SelectedItem="{Binding ElementName=Tree, Path=FilterNodeMode, Mode=TwoWay}" />
                    <CheckBox Content="Expand nodes on filtering"
                              IsChecked="{Binding ElementName=Tree, Path=ExpandNodesOnFiltering, Mode=TwoWay}" />

                    <TextBlock Text="EDITING" Style="{StaticResource SectionHeader}" />
                    <CheckBox Content="Allow editing"
                              IsChecked="{Binding ElementName=Tree, Path=AllowEditing, Mode=TwoWay}" />
                    <TextBlock Text="Edit trigger" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding EditTriggers}"
                              SelectedItem="{Binding ElementName=Tree, Path=EditTrigger, Mode=TwoWay}" />
                    <CheckBox Content="Bulk edit selection (Ctrl+Enter)"
                              IsChecked="{Binding ElementName=Tree, Path=AllowBulkValueChange, Mode=TwoWay}" />
                    <CheckBox Content="Confirm when values differ"
                              IsChecked="{Binding ElementName=Tree, Path=ShowBulkValueChangeConfirmation, Mode=TwoWay}" />
                    <TextBlock Text="Select several rows, edit one cell, then commit with Ctrl+Enter to fill the rest of the column."
                               TextWrapping="Wrap" FontSize="10"
                               Foreground="{DynamicResource TreeGrid.ExpanderGlyph}" Margin="0,2,0,4" />

                    <TextBlock Text="Validation mode" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding ValidationModes}"
                              SelectedItem="{Binding ElementName=Tree, Path=ValidationMode, Mode=TwoWay}" />

                    <TextBlock Text="COLUMNS" Style="{StaticResource SectionHeader}" />
                    <CheckBox Content="Allow resizing"
                              IsChecked="{Binding ElementName=Tree, Path=AllowColumnResizing, Mode=TwoWay}" />
                    <CheckBox Content="Allow reordering"
                              IsChecked="{Binding ElementName=Tree, Path=AllowColumnReordering, Mode=TwoWay}" />
                    <CheckBox Content="Column virtualization"
                              IsChecked="{Binding ElementName=Tree, Path=EnableColumnVirtualization, Mode=TwoWay}" />
                    <TextBlock Text="Frozen columns (left)" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding FreezeCounts}"
                              SelectedItem="{Binding ElementName=Tree, Path=FrozenColumnCount, Mode=TwoWay}" />
                    <TextBlock Text="Frozen columns (right)" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding FreezeCounts}"
                              SelectedItem="{Binding ElementName=Tree, Path=FooterColumnCount, Mode=TwoWay}" />
                    <Button Content="Restore hidden columns" Margin="0,6,0,0" Padding="6,3"
                            Click="OnRestoreColumns" />

                    <TextBlock Text="LAYOUT" Style="{StaticResource SectionHeader}" />
                    <CheckBox Content="Stacked headers" x:Name="StackedHeaderBox"
                              Checked="OnStackedHeadersChanged" Unchecked="OnStackedHeadersChanged" />
                    <CheckBox Content="Alternating rows"
                              IsChecked="{Binding ElementName=Tree, Path=ShowAlternatingRows, Mode=TwoWay}" />
                    <CheckBox Content="Right-to-left" x:Name="RtlBox"
                              Checked="OnRtlChanged" Unchecked="OnRtlChanged" />
                    <CheckBox Content="Dark theme" x:Name="DarkThemeBox"
                              Checked="OnThemeChanged" Unchecked="OnThemeChanged" />

                    <TextBlock Text="GROUPING" Style="{StaticResource SectionHeader}" />
                    <CheckBox Content="Allow grouping"
                              IsChecked="{Binding ElementName=Tree, Path=AllowGrouping, Mode=TwoWay}" />
                    <CheckBox Content="Show group panel"
                              IsChecked="{Binding ElementName=Tree, Path=ShowGroupDropArea, Mode=TwoWay}" />
                    <CheckBox Content="Hide grouped columns"
                              IsChecked="{Binding ElementName=Tree, Path=HideGroupedColumns, Mode=TwoWay}" />
                    <CheckBox Content="Show item counts"
                              IsChecked="{Binding ElementName=Tree, Path=ShowGroupItemCount, Mode=TwoWay}" />
                    <CheckBox Content="Auto-expand new groups"
                              IsChecked="{Binding ElementName=Tree, Path=AutoExpandGroups, Mode=TwoWay}" />
                    <CheckBox Content="Drag preview (ghost)"
                              IsChecked="{Binding ElementName=Tree, Path=ShowDragPreview, Mode=TwoWay}" />
                    <TextBlock Text="Right-click a header for the Group By Box toggle and two custom items."
                               TextWrapping="Wrap" FontSize="10"
                               Foreground="{DynamicResource TreeGrid.ExpanderGlyph}" Margin="0,2,0,0" />
                    <CheckBox Content="Show footer"
                              IsChecked="{Binding ElementName=Tree, Path=ShowFooter, Mode=TwoWay}" />
                    <CheckBox Content="Log grouping events" x:Name="LogGroupEventsBox" IsChecked="True" />
                    <TextBlock Text="Drag a column header onto the panel to group. Drag chips to reorder, click one to flip its direction, × to ungroup."
                               TextWrapping="Wrap" FontSize="10"
                               Foreground="{DynamicResource TreeGrid.ExpanderGlyph}" Margin="0,2,0,0" />
                    <UniformGrid Columns="2" Margin="0,4,0,0">
                        <Button Content="Group: Title" Margin="0,0,3,3" Padding="4,3" Click="OnGroupByTitle" />
                        <Button Content="+ Available" Margin="3,0,0,3" Padding="4,3" Click="OnGroupByAvailable" />
                        <Button Content="Expand groups" Margin="0,0,3,0" Padding="4,3" Click="OnExpandGroups" />
                        <Button Content="Ungroup all" Margin="3,0,0,0" Padding="4,3" Click="OnClearGrouping" />
                    </UniformGrid>

                    <TextBlock Text="APPEARANCE" Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="Header background" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Palette}"
                              SelectedItem="{Binding ElementName=Tree, Path=HeaderBackground, Mode=TwoWay}"
                              ItemTemplate="{StaticResource SwatchTemplate}" />
                    <TextBlock Text="Header foreground" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Palette}"
                              SelectedItem="{Binding ElementName=Tree, Path=HeaderForeground, Mode=TwoWay}"
                              ItemTemplate="{StaticResource SwatchTemplate}" />
                    <TextBlock Text="Selected row background" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Palette}"
                              SelectedItem="{Binding ElementName=Tree, Path=SelectedRowBackground, Mode=TwoWay}"
                              ItemTemplate="{StaticResource SwatchTemplate}" />
                    <TextBlock Text="Hover row background" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Palette}"
                              SelectedItem="{Binding ElementName=Tree, Path=HoverRowBackground, Mode=TwoWay}"
                              ItemTemplate="{StaticResource SwatchTemplate}" />
                    <TextBlock Text="Sort icon colour" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Palette}"
                              SelectedItem="{Binding ElementName=Tree, Path=SortIconBrush, Mode=TwoWay}"
                              ItemTemplate="{StaticResource SwatchTemplate}" />
                    <TextBlock Text="Filter icon colour" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Palette}"
                              SelectedItem="{Binding ElementName=Tree, Path=FilterIconBrush, Mode=TwoWay}"
                              ItemTemplate="{StaticResource SwatchTemplate}" />
                    <TextBlock Text="Filter popup background" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Palette}"
                              SelectedItem="{Binding ElementName=Tree, Path=FilterPopupBackground, Mode=TwoWay}"
                              ItemTemplate="{StaticResource SwatchTemplate}" />
                    <TextBlock Text="Filter popup text" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Palette}"
                              SelectedItem="{Binding ElementName=Tree, Path=FilterPopupForeground, Mode=TwoWay}"
                              ItemTemplate="{StaticResource SwatchTemplate}" />
                    <TextBlock Text="Filter editor text" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Palette}"
                              SelectedItem="{Binding ElementName=Tree, Path=FilterInputForeground, Mode=TwoWay}"
                              ItemTemplate="{StaticResource SwatchTemplate}" />
                    <TextBlock Text="Filter editor background" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Palette}"
                              SelectedItem="{Binding ElementName=Tree, Path=FilterInputBackground, Mode=TwoWay}"
                              ItemTemplate="{StaticResource SwatchTemplate}" />

                    <TextBlock Text="Filter list background" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Palette}"
                              SelectedItem="{Binding ElementName=Tree, Path=FilterListBackground, Mode=TwoWay}"
                              ItemTemplate="{StaticResource SwatchTemplate}" />

                    <TextBlock Text="Grid line colour" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Palette}"
                              SelectedItem="{Binding ElementName=Tree, Path=GridLineBrush, Mode=TwoWay}"
                              ItemTemplate="{StaticResource SwatchTemplate}" />
                    <TextBlock Text="Grid lines" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding GridLineOptions}"
                              SelectedItem="{Binding ElementName=Tree, Path=GridLinesVisibility, Mode=TwoWay}" />
                    <TextBlock Text="Header font weight" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding FontWeightOptions}"
                              SelectedItem="{Binding ElementName=Tree, Path=HeaderFontWeight, Mode=TwoWay}" />
                    <TextBlock Text="Font family" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding FontFamilies}"
                              SelectedItem="{Binding ElementName=Tree, Path=CellFontFamily, Mode=TwoWay}" />

                    <TextBlock Style="{StaticResource FieldLabel}"
                               Text="{Binding ElementName=CellFontSlider, Path=Value, StringFormat='Cell font size: {0:F0}'}" />
                    <Slider x:Name="CellFontSlider" Minimum="9" Maximum="20" TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Value="{Binding ElementName=Tree, Path=CellFontSize, Mode=TwoWay}" />

                    <TextBlock Style="{StaticResource FieldLabel}"
                               Text="{Binding ElementName=RowHeightSlider, Path=Value, StringFormat='Row height: {0:F0}'}" />
                    <Slider x:Name="RowHeightSlider" Minimum="20" Maximum="56" TickFrequency="2"
                            IsSnapToTickEnabled="True"
                            Value="{Binding ElementName=Tree, Path=RowHeight, Mode=TwoWay}" />

                    <TextBlock Style="{StaticResource FieldLabel}"
                               Text="{Binding ElementName=IndentSlider, Path=Value, StringFormat='Indent per level: {0:F0}'}" />
                    <Slider x:Name="IndentSlider" Minimum="8" Maximum="48" TickFrequency="2"
                            IsSnapToTickEnabled="True"
                            Value="{Binding ElementName=Tree, Path=IndentPerLevel, Mode=TwoWay}" />

                    <CheckBox Content="Conditional formatting" x:Name="ConditionalBox"
                              Checked="OnConditionalChanged" Unchecked="OnConditionalChanged" />
                    <TextBlock Text="Salary over 150k in green, under 60k in red, Directors bold."
                               TextWrapping="Wrap" FontSize="10"
                               Foreground="{DynamicResource TreeGrid.ExpanderGlyph}" />
                    <Button Content="Reset appearance" Margin="0,6,0,0" Padding="6,3"
                            Click="OnResetAppearance" />

                    <TextBlock Text="INTERACTION" Style="{StaticResource SectionHeader}" />
                    <CheckBox Content="Row drag and drop"
                              IsChecked="{Binding ElementName=Tree, Path=AllowRowDragDrop, Mode=TwoWay}" />
                    <CheckBox Content="Update source on drop"
                              IsChecked="{Binding ElementName=Tree, Path=UpdateSourceOnRowDrop, Mode=TwoWay}" />
                    <CheckBox Content="Default context menus"
                              IsChecked="{Binding ElementName=Tree, Path=ShowDefaultContextMenus, Mode=TwoWay}" />
                    <CheckBox Content="Custom row + header menus" x:Name="CustomMenusBox"
                              Checked="OnCustomMenusChanged" Unchecked="OnCustomMenusChanged" />
                    <CheckBox Content="Allow copy (Ctrl+C)"
                              IsChecked="{Binding ElementName=Tree, Path=AllowCopy, Mode=TwoWay}" />
                    <CheckBox Content="Delete selected rows (Del)"
                              IsChecked="{Binding ElementName=Tree, Path=AllowDeleteRows, Mode=TwoWay}" />
                    <CheckBox Content="Confirm before deleting"
                              IsChecked="{Binding ElementName=Tree, Path=ConfirmRowDelete, Mode=TwoWay}" />
                    <CheckBox Content="Allow paste (Ctrl+V)"
                              IsChecked="{Binding ElementName=Tree, Path=AllowPaste, Mode=TwoWay}" />
                    <CheckBox Content="Excel tabular paste"
                              IsChecked="{Binding ElementName=Tree, Path=AllowExcelPaste, Mode=TwoWay}" />
                    <TextBlock Text="Copy a block of cells in Excel, select a starting cell here, then Ctrl+V."
                               TextWrapping="Wrap" FontSize="10"
                               Foreground="{DynamicResource TreeGrid.ExpanderGlyph}" Margin="0,2,0,0" />

                    <TextBlock Text="ACTIONS" Style="{StaticResource SectionHeader}" />
                    <UniformGrid Columns="2">
                        <Button Content="Expand all" Margin="0,0,3,3" Padding="4,3" Click="OnExpandAll" />
                        <Button Content="Collapse all" Margin="3,0,0,3" Padding="4,3" Click="OnCollapseAll" />
                        <Button Content="Auto-fit" Margin="0,0,3,3" Padding="4,3" Click="OnAutoFit" />
                        <Button Content="Clear sort" Margin="3,0,0,3" Padding="4,3" Click="OnClearSort" />
                        <Button Content="Clear filters" Margin="0,0,3,3" Padding="4,3" Click="OnClearFilters" />
                        <Button Content="Select all" Margin="3,0,0,3" Padding="4,3" Click="OnSelectAll" />
                        <Button Content="Export" Margin="0,0,3,0" Padding="4,3" Click="OnExport" />
                        <Button Content="Benchmark" Margin="3,0,0,0" Padding="4,3" Click="OnBenchmark" />
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ==================================================== Grid surface -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Padding="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Data source:" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="SourceBox" Width="180" SelectionChanged="OnSourceChanged">
                        <ComboBoxItem Content="Hierarchical" IsSelected="True" />
                        <ComboBoxItem Content="Self-relational (5,000)" />
                        <ComboBoxItem Content="Load on demand (async)" />
                    </ComboBox>

                    <TextBlock VerticalAlignment="Center" Margin="16,0,0,0"
                               Text="{Binding ElementName=Tree, Path=View.Count, StringFormat='Rows: {0}'}" />
                    <TextBlock VerticalAlignment="Center" Margin="12,0,0,0"
                               Text="{Binding ElementName=Tree, Path=SelectedItems.Count, StringFormat='Selected: {0}'}" />
                    <TextBlock VerticalAlignment="Center" Margin="12,0,0,0"
                               Text="{Binding ElementName=Tree, Path=CheckedItems.Count, StringFormat='Checked: {0}'}" />
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="12,0,0,0"
                               Foreground="{DynamicResource TreeGrid.ExpanderGlyph}" />
                </StackPanel>
            </Border>

            <tg:TreeGridControl x:Name="Tree"
                                AutoGenerateColumns="False"
                                ShowAlternatingRows="True"
                                AllowCheckBoxSelection="True"
                                SelectedMemberPath="IsSelected"
                                CheckedMemberPath="IsChecked"
                                ObserveMemberPathChanges="True"
                                AllowSorting="True"
                                AllowMultiSort="True"
                                AllowFiltering="True"
                                AllowEditing="True"
                                EditTrigger="OnDoubleTap"
                                ValidationMode="CellAndRow"
                                AllowColumnResizing="True"
                                AllowColumnReordering="True"
                                AllowRowDragDrop="True"
                                AllowCopy="True"
                                AllowPaste="True"
                                ShowDefaultContextMenus="True"
                                AllowGrouping="True"
                                ShowGroupDropArea="True"
                                FrozenColumnCount="1">
                <tg:TreeGridControl.Columns>
                    <cols:TreeGridTextColumn MappingName="FirstName" HeaderText="First Name" Width="220" />
                    <cols:TreeGridTextColumn MappingName="LastName" HeaderText="Last Name" Width="130" />
                    <cols:TreeGridComboBoxColumn x:Name="TitleColumn" MappingName="Title"
                                                 HeaderText="Title" Width="150" />
                    <!-- Digits only: letters, symbols and a second separator are all
                         refused as you type. MinValue="0" also blocks the minus sign. -->
                    <cols:TreeGridNumericColumn MappingName="Salary" HeaderText="Salary"
                                                Width="120"
                                                NumberDecimalDigits="2"
                                                AllowDecimals="True"
                                                MinValue="0" MaxValue="500000" />
                    <!-- Read-only boolean rendered as an icon, not an editable checkbox -->
                    <cols:TreeGridBooleanIconColumn MappingName="Available" HeaderText="Available"
                                                    Width="90"
                                                    TrueText="Available" FalseText="Unavailable" />
                    <cols:TreeGridProgressBarColumn MappingName="Completion" HeaderText="Completion" Width="130" />
                    <cols:TreeGridHyperlinkColumn MappingName="ProfileUrl" HeaderText="Profile" Width="170" />

                    <!-- Custom template column: arbitrary content, DataContext is the record.
                         SortMemberPath sorts by Salary even though the cell shows a band. -->
                    <cols:TreeGridTemplateColumn HeaderText="Band" Width="150"
                                                 MappingName="Salary"
                                                 SortMemberPath="Salary">
                        <cols:TreeGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="#1F6FEB"
                                             VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <TextBlock Text="{Binding HeaderText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </cols:TreeGridTemplateColumn.HeaderTemplate>
                        <cols:TreeGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="9" Padding="7,1" HorizontalAlignment="Left"
                                        Margin="6,0,0,0"
                                        Background="{Binding Salary, Converter={StaticResource BandBrushConverter}}">
                                    <TextBlock Text="{Binding Salary, Converter={StaticResource BandTextConverter}}"
                                               Foreground="White" FontSize="10" />
                                </Border>
                            </DataTemplate>
                        </cols:TreeGridTemplateColumn.CellTemplate>
                        <cols:TreeGridTemplateColumn.EditTemplate>
                            <DataTemplate>
                                <Slider Minimum="0" Maximum="250000" SmallChange="1000"
                                        VerticalAlignment="Center"
                                        Value="{Binding Salary, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </cols:TreeGridTemplateColumn.EditTemplate>
                    </cols:TreeGridTemplateColumn>
                </tg:TreeGridControl.Columns>
            </tg:TreeGridControl>
        </DockPanel>
    </Grid>
</Window>
